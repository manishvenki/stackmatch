# StackMatch Full-Stack Environment Configuration

# Backend Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
PUBLIC_STACKMATCH_URL=https://stackmatch.dev

# Database Persistence (MongoDB)
MONGODB_URI=mongodb://localhost:27017/stackmatch

# Security & Authentication
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars
JWT_EXPIRES_IN=7d

# Google AI Planning Intelligence (Gemini)
# Set your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
AI_PROVIDER=gemini

# Web Frontend
VITE_API_BASE_URL=
