# =================================================================
# StackMatch Environment Configuration Template
# Copy this file to .env and provide your local credentials
# =================================================================

# -------------------------------------------------------------
# Backend Service Configuration (Used by Express Backend & Docker)
# -------------------------------------------------------------
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:3000
PUBLIC_STACKMATCH_URL=http://localhost:3000

# Database Persistence (MongoDB Atlas)
# NOTE: Ensure your MongoDB Atlas IP Access List allows connections from
# the host running Docker (e.g., your current public IP address).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/stackmatch?retryWrites=true&w=majority

# Security & Authentication
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars
JWT_EXPIRES_IN=7d

# Google AI Planning Intelligence (Gemini)
# Obtain your key at: https://aistudio.google.com/
AI_PROVIDER=gemini
GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# -------------------------------------------------------------
# Frontend Service Configuration (Vite & Nginx Container)
# -------------------------------------------------------------
# Leave empty for Docker Compose deployment so Nginx handles /api/v1 reverse-proxying.
# If connecting directly to an external backend host, specify: http://localhost:5000/api/v1
VITE_API_BASE_URL=
