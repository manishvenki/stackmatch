# StackMatch Full-Stack Environment Configuration

# Backend
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/stackmatch
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# AI Planning Intelligence
# Options: 'openai', 'anthropic', 'mock'
