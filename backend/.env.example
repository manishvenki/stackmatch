# StackMatch Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB connection string; fallback to in-memory store if unreachable)
MONGODB_URI=mongodb://localhost:27017/stackmatch

# Security & Authentication
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# AI Planning Intelligence Provider
# Options: 'gemini', 'openai', 'anthropic', 'mock'
AI_PROVIDER=gemini
GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
PUBLIC_STACKMATCH_URL=https://stackmatch.dev
